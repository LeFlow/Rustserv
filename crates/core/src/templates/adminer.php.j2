function adminer_object()
{
    class AdminerRustserv extends \Adminer\Adminer
    {
        function name()
        {
            return 'Rustserv';
        }

        function credentials()
        {
            // Instance choisie dans l'URL (?server=… ou ?pgsql=…), sinon celle par défaut.
            $serveur = defined('Adminer\SERVER') && \Adminer\SERVER !== '' ? \Adminer\SERVER : '127.0.0.1:{{ port }}';
            $utilisateur = isset($_GET['pgsql']) ? 'postgres' : 'root';
            return [$serveur, $utilisateur, ''];
        }

        // Les bases de développement n'ont pas de mot de passe : connexion acceptée.
        function login($login, $password)
        {
            return true;
        }

        // Pas de jeton anti-CSRF pour la connexion automatique (page locale uniquement).
        function verifyLoginToken()
        {
            return false;
        }
    }
    return new AdminerRustserv();
}

// Première visite (ou après déconnexion) : connexion automatique, à l'instance
// demandée par ?port=31104 (&driver=pgsql pour PostgreSQL) ou à celle par défaut.
if (!isset($_GET['username']) && empty($_POST)) {
    $port = isset($_GET['port']) ? (int) $_GET['port'] : {{ port }};
    if ($port < 1024 || $port > 65535) {
        $port = {{ port }};
    }
    $pgsql = isset($_GET['driver']) && $_GET['driver'] === 'pgsql';
    $_POST['auth'] = [
        'driver' => $pgsql ? 'pgsql' : 'server',
        'server' => '127.0.0.1:' . $port,
        'username' => $pgsql ? 'postgres' : 'root',
        'password' => '',
        'db' => '',
    ];
}

include '{{ adminer_php }}';
