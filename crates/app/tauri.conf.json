{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rustserv",
  "version": "0.1.0",
  "identifier": "dev.rustserv.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../ui/dist",
    "beforeDevCommand": { "script": "pnpm dev", "cwd": "../.." },
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../.." }
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
